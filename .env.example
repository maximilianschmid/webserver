# Database Configuration
MYSQL_ROOT_PASSWORD=change_me_root_password

# phpMyAdmin
PMA_HOST=mysql-db

# Production only: make plain `docker compose` commands use the prod override
# instead of the dev one (docker-compose.override.yaml). Uncomment on the server:
#COMPOSE_FILE=docker-compose.yaml:docker-compose.prod.yaml

# Production also needs two gitignored files (see the *.example templates):
#   traefik/typo3.htpasswd                  - basic auth for /typo3 backends
#   mysqld/initdb.d/01-create-databases.sql - real DB passwords
