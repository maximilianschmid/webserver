# Template for traefik/typo3.htpasswd (gitignored) — basic auth in front of
# the TYPO3 backend (/typo3) in production.
#
# Generate a user line with bcrypt:
#   htpasswd -nB editors
# or without htpasswd installed:
#   docker run --rm httpd:2.4 htpasswd -nbB editors 'choose-a-strong-password'
#
# Then replace the line below with the real output:
editors:$2y$05$replace.me.with.a.real.bcrypt.hash
